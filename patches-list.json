  "patches": [
    {
      "name": "Clone app",
      "description": "Changes the app package name to allow installing the same app multiple times. By default \".morphe\" is appended to the package name. Each cloned install must use a unique package name. Cloning does not work with all apps and using this patch may cause app crashes or other unexpected behavior.",
      "default": false,
      "category": null,
      "compatiblePackages": null,
      "options": [
        {
          "key": "packageName",
          "title": "Package name",
          "description": "Package name to use for the cloned app.",
          "required": true,
          "type": "kotlin.String",
          "default": "Default",
          "values": {
            "Default": "Default"
          }
        },
        {
          "key": "updatePermissions",
          "title": "Update permissions",
          "description": "Update custom permissions declared by the app. Fixes installation conflicts, but can break features in certain apps.",
          "required": false,
          "type": "kotlin.Boolean",
          "default": true,
          "values": null
        },
        {
          "key": "updateProviders",
          "title": "Update providers",
          "description": "Update provider names declared by the app. Fixes installation conflicts, but can break features in certain apps.",
          "required": false,
          "type": "kotlin.Boolean",
          "default": true,
          "values": null
        }
      ]
    },
